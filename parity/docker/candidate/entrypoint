#!/bin/sh
# Entrypoint for the ember-candidate parity image (the Rust app).
#
# FAKETIME   libfaketime spec: "@2026-03-02 16:00:00" starts the clock at that instant and lets it
#            tick; "2026-03-02 16:00:00" freezes it there. Monotonic clocks stay real, so Tokio's
#            timers keep working. Same spec and library as the reference image's entrypoint.
#            (Thruster is a static Go binary, so its clock stays real, as in the reference.)
# EMBER_FROZEN_TIME  the app's own frozen clock (crates/rails_compat/src/clock.rs); parity/bin/candidate
#            sets it together with a frozen FAKETIME for --freeze.
set -e

# The copied Rails seed explicitly enables translation controls for comparison. Production
# defaults and the administrator toggle are covered with fresh databases by test:kro.
if [ -f /rails/storage/db/production.sqlite3 ]; then
  sqlite3 /rails/storage/db/production.sqlite3 \
    "UPDATE accounts SET settings = json_set(COALESCE(settings, '{}'), '$.hide_translation_buttons', json('false'));"
fi

if [ -n "$FAKETIME" ]; then
  export LD_PRELOAD=/usr/local/lib/faketime/libfaketime.so.1
  export FAKETIME_DONT_FAKE_MONOTONIC=1
  export FAKETIME_DONT_RESET=1
fi

exec "$@"
