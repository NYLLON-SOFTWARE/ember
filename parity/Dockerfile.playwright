# The one image every parity capture runs in, for both the Rails reference and the Rust port.
# Pinned by digest: browsers, fonts, fontconfig and Node all come from these exact bytes, so a
# capture never depends on the host. No GPU: Chromium falls back to SwiftShader.
#
# parity/bin/capture and parity/bin/compare build this as matchbox-parity-playwright:<hash>. When
# the Docker daemon isn't reachable they materialize the same FROM image with
# parity/capture/sandbox/rootfs.sh and run it under bubblewrap, performing the same steps as below.
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27

ENV TZ=UTC \
    LANG=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# The locked harness modules live at /node_modules: Node's resolution walks up from the mounted
# parity/capture/*.ts to /, and the runner hides the host's parity/node_modules with a tmpfs.
COPY package.json package-lock.json /opt/parity/
RUN cd /opt/parity && npm ci --omit=dev --no-audit --no-fund && mv node_modules /node_modules
