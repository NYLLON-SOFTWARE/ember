{
  "name": {{ self.json(account_name.as_deref().unwrap_or("Matchbox")) }},
  "icons": [
    {
      "src": {{ self.json(logo_path_small) }},
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": {{ self.json(logo_path) }},
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": {{ self.json(logo_path) }},
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "A chat app from the makers of Basecamp and HEY.",
  "categories": ["social", "business", "productivity"],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "shortcuts": [
    {
      "name": "New chat room",
      "description": "Open Matchbox and start a new chat room",
      "url": "rooms/opens/new",
      "icons": [{ "src": {{ self.json(self.image_url("add.svg").as_str()) }}, "sizes": "any" }]
    },
    {
      "name": "My profile",
      "description": "Open Matchbox and view your profile",
      "url": "/users/me/profile",
      "icons": [{ "src": {{ self.json(self.image_url("person.svg").as_str()) }}, "sizes": "any" }]
    }
  ],
  "screenshots": [
    {
      "src": {{ self.json(self.image_url("screenshots/android-chat.png").as_str()) }},
      "sizes": "1080x2400",
      "form_factor": "narrow",
      "label": "Matchbox is an installable, self-hosted group chat system."
    },
    {
      "src": {{ self.json(self.image_url("screenshots/android-sidebar.png").as_str()) }},
      "sizes": "1080x2400",
      "form_factor": "narrow",
      "label": "Easily invite people. Make rooms. @mentions, DMs, and mobile support."
    },
    {
      "src": {{ self.json(self.image_url("screenshots/android-dark-mode.png").as_str()) }},
      "sizes": "1080x2400",
      "form_factor": "narrow",
      "label": "Full support for dark mode, customizable to your brand."
    }
  ]
}

